# Staging / Production Environment Designation
NEXT_PUBLIC_APP_ENV=staging

# Supabase Configuration
# Client-safe Public Keys (Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# Server-Only Secret Key (NEVER use NEXT_PUBLIC_ prefix - Keep hidden from browser!)
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# AI Provider Configuration (Server-Side Only)
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Stripe-ready placeholders for future billing
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
